:root {
  --cursor-visibility: hidden; }

@keyframes blink {
  0% {
    opacity: 0; }
  100% {
    opacity: 1; } }

::-webkit-scrollbar {
  width: 10px; }

::-webkit-scrollbar-track {
  border-radius: 10px;
  box-shadow: inset 0 0 1px #3a3d3e; }

::-webkit-scrollbar-thumb {
  border-radius: 10px;
  box-shadow: 0 0 0 1px #4a4e50; }
